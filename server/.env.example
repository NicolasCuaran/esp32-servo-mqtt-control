# Copia este archivo a `.env` y ajusta a tu entorno.

# Broker MQTT. Debe coincidir con `firmware/.../config.h`.
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Identificador unico del dispositivo (mismo valor que DEVICE_ID en el firmware).
DEVICE_ID=ece88b61

# Cantidad de servos conectados (mismo valor que NUM_SERVOS en el firmware).
# 1..4
NUM_SERVOS=1

# API HTTP
API_HOST=0.0.0.0
API_PORT=8000
